# Modèle de développement LOCAL Windows : Node.js + React/Vite.
PORT=3000
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Compatibilité temporaire uniquement : préférer SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# CORS et cookies pour http://localhost uniquement
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_MAX_AGE_MS=

# Initialisation unique du premier administrateur
BOOTSTRAP_ADMIN_SECRET=
# Demande d'information : secret aléatoire local, au moins 32 caractères.
# Générer une valeur privée ; ne jamais la copier dans le frontend ou la committer.
DEMANDE_INFORMATION_SECRET=

# Inscription : secret prive stable >=32 caracteres, partage par les instances.
INSCRIPTION_TRACKING_SECRET=
