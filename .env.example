# Développement local uniquement : le Worker Cloudflare utilise Hyperdrive.
PORT=
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Compatibilité temporaire uniquement : préférer SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# CORS et cookies (production Cloudflare)
FRONTEND_URL=
NODE_ENV=production
AUTH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_MAX_AGE_MS=

# Initialisation unique du premier administrateur
BOOTSTRAP_ADMIN_SECRET=