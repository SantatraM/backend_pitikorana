import test from "node:test";
import assert from "node:assert/strict";
import { runWithDatabaseClient } from "../src/config/db.js";
import { transitionTetikasa } from "../src/services/tetikasa.service.js";

const id = "11111111-1111-4111-8111-111111111111";
const revision = "2026-10-17T10:00:00.123456Z";
const auth = (role) => ({ personne: { id: "22222222-2222-4222-8222-222222222222" }, compte: { role } });

function mockDb(overrides = {}) {
  const state = {
    project: { id, titre: "Titre", description: "Description", objectif: "Objectif", beneficiaires: "Tous", lieu: "Lieu", lieu_non_defini: false, date_debut_prevue: "2026-10-01", date_fin_prevue: "2026-10-31", revision, statut_code: "DRAFITRA", ...overrides.project },
    has_responsable: true, has_action: true, budget: [], history: [], ...overrides,
  };
  let snapshot;
  const calls = [];
  return { state, calls, async query(sql, params = []) {
    calls.push(sql);
    if (sql === "BEGIN") { snapshot = structuredClone(state); return { rows: [] }; }
    if (sql === "COMMIT") return { rows: [] };
    if (sql === "ROLLBACK") { Object.assign(state, snapshot); return { rows: [] }; }
    if (sql.includes("FOR UPDATE OF t")) return { rows: state.project ? [state.project] : [] };
    if (sql.includes("AS has_responsable")) return { rows: [{ has_responsable: state.has_responsable, has_action: state.has_action }] };
    if (sql.includes("FROM tetikasa_ligne_budget")) return { rows: state.budget };
    if (sql.includes("SELECT id FROM statut_tetikasa")) return { rows: state.missingStatus ? [] : [{ id: params[0] }] };
    if (sql.includes("UPDATE tetikasa SET id_statut_tetikasa")) {
      state.project.statut_code = params[0];
      state.project.revision = "2026-10-17T10:00:00.123457Z";
      return { rows: [{ revision: state.project.revision }] };
    }
    if (sql.includes("INSERT INTO tetikasa_historique")) {
      if (state.failHistory) throw new Error("history failure");
      state.history.push(params); return { rows: [] };
    }
    throw new Error(`Unexpected query: ${sql}`);
  } };
}

const run = (db, action, role = "ADMIN", extra = {}) => runWithDatabaseClient(db, () => transitionTetikasa(id, { action, revision, ...extra }, auth(role)));

test("quatre transitions autorisées, acteur et historique", async () => {
  for (const [action, source, target, role, commentaire] of [
    ["SOUMISSION_VALIDATION", "DRAFITRA", "EN_ATTENTE_VALIDATION", "BUREAU_ZANAKA_AMPIELEZANA", null],
    ["VALIDATION", "EN_ATTENTE_VALIDATION", "VALIDE", "PASTEUR", null],
    ["REFUS", "EN_ATTENTE_VALIDATION", "REFUSE", "ADMIN", "Motif"],
    ["RETOUR_CORRECTION", "EN_ATTENTE_VALIDATION", "DRAFITRA", "PASTEUR", "Corriger"],
  ]) {
    const db = mockDb({ project: { ...mockDb().state.project, statut_code: source } });
    const result = await run(db, action, role, { commentaire });
    assert.equal(result.tetikasa.statut, target);
    assert.notEqual(result.tetikasa.revision, revision);
    assert.deepEqual(db.state.history[0], [id, action, auth(role).personne.id, commentaire]);
    assert.equal(db.calls.at(-1), "COMMIT");
  }
});

test("rôles, états terminaux, motifs et révisions sont contrôlés", async () => {
  for (const action of ["VALIDATION", "REFUS", "RETOUR_CORRECTION"]) {
    await assert.rejects(run(mockDb(), action, "BUREAU_ZANAKA_AMPIELEZANA", { commentaire: "Motif" }), { code: "TETIKASA_FORBIDDEN" });
  }
  await assert.rejects(run(mockDb(), "SOUMISSION_VALIDATION", "MEMBRE"), { code: "TETIKASA_FORBIDDEN" });
  for (const statut_code of ["REFUSE", "VALIDE"]) for (const action of ["SOUMISSION_VALIDATION", "VALIDATION", "REFUS", "RETOUR_CORRECTION"]) {
    const db = mockDb(); db.state.project.statut_code = statut_code;
    await assert.rejects(run(db, action, "ADMIN", { commentaire: "Motif" }), { code: "TETIKASA_STATE_INVALID" });
    assert.equal(db.calls.at(-1), "ROLLBACK");
  }
  for (const action of ["REFUS", "RETOUR_CORRECTION"]) await assert.rejects(run(mockDb(), action, "ADMIN", { commentaire: "  " }), { code: "TETIKASA_INVALID" });
  const db = mockDb();
  await assert.rejects(run(db, "SOUMISSION_VALIDATION", "ADMIN", { revision: "2026-10-17T10:00:00.123455Z" }), { code: "TETIKASA_REVISION_CONFLICT" });
  assert.equal(db.calls.at(-1), "ROLLBACK");
});

test("complétude, budget facultatif et rollback", async () => {
  for (const field of ["titre", "description", "objectif", "beneficiaires", "lieu", "date_debut_prevue", "date_fin_prevue"]) {
    const db = mockDb(); db.state.project[field] = null;
    await assert.rejects(run(db, "SOUMISSION_VALIDATION"), (error) => error.code === "TETIKASA_INCOMPLETE" && error.fields.includes(field));
  }
  for (const field of ["has_responsable", "has_action"]) {
    const db = mockDb(); db.state[field] = false;
    await assert.rejects(run(db, "SOUMISSION_VALIDATION"), { code: "TETIKASA_INCOMPLETE" });
  }
  const allowed = mockDb({ budget: [{ designation: "Ligne", quantite: "1.000", prix_unitaire_estime: "0.00" }] });
  allowed.state.project.lieu = null; allowed.state.project.lieu_non_defini = true;
  await run(allowed, "SOUMISSION_VALIDATION");
  const invalid = mockDb({ budget: [{ designation: "Ligne", quantite: "0.000", prix_unitaire_estime: "0.00" }] });
  await assert.rejects(run(invalid, "SOUMISSION_VALIDATION"), { code: "TETIKASA_INVALID" });
  const dates = mockDb(); dates.state.project.date_fin_prevue = "2026-09-30";
  await assert.rejects(run(dates, "SOUMISSION_VALIDATION"), { code: "TETIKASA_INVALID" });
  const failure = mockDb({ failHistory: true });
  await assert.rejects(run(failure, "SOUMISSION_VALIDATION"), /history failure/);
  assert.equal(failure.state.project.statut_code, "DRAFITRA");
  assert.equal(failure.state.project.revision, revision);
  assert.deepEqual(failure.state.history, []);
  assert.equal(failure.calls.at(-1), "ROLLBACK");
});
